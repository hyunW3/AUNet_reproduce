+    def _generate_inc_chunked(self, prompts: List[str]) -> List[str]:
+        """Cached generation for the root_greedy arm, packed so each chunk fits BOTH the byte
+        budget (max_tokens) and the patch transformer (trunk.max_seqlen). The cache pads every row
+        by max_gen_len at the patch level too, so that padding is budgeted per row. A prompt whose
+        own patches cannot fit is cut from the front at a patch boundary (as _generate_until_bt)."""
+        gen = self.generator
+        tok, pool = gen.tokenizer, gen.regex_pool
+        g = int(gen.max_gen_len)                                     # internal (setter x2) length
+        max_tokens = getattr(gen, "max_tokens", None) or 16384
+        try:
+            patch_limit = int(gen.model.trunk.max_seqlen)
+        except Exception:
+            patch_limit = None
+        MARGIN = 32
+        rows = []
+        for p in prompts:
+            pb = tok.encode(p, add_bos=False, add_eos=False)
+            npc = sum(1 for x in (pool.get_levels_mask(pb) if pb else []) if x > 0) + 1   # +BOS
+            if patch_limit and npc + g + MARGIN > patch_limit:
+                lm = pool.get_levels_mask(pb)
+                bnds = [i for i, v in enumerate(lm) if v > 0]
+                keep = max(1, patch_limit - g - MARGIN - 1)
+                if len(bnds) > keep:
+                    pb = pb[bnds[len(bnds) - keep]:]
+                    p = bytes(x for x in pb if x < 256).decode("utf-8", errors="ignore")
+                    logger.warning("generate_until[inc]: prompt cut to the last %d patches", keep)
+                npc = sum(1 for x in pool.get_levels_mask(pb) if x > 0) + 1
+            rows.append((p, len(pb) + 1 + g, npc + g + MARGIN))
+        out, cur, cb, cp = [], [], 0, 0
+        for p, b_cost, p_cost in rows:
+            if cur and (cb + b_cost > max_tokens or (patch_limit and cp + p_cost > patch_limit)):
+                out.extend(gen.generate(cur)[0])
+                cur, cb, cp = [], 0, 0
+            cur.append(p)
+            cb += b_cost
+            cp += p_cost
+        if cur:
+            out.extend(gen.generate(cur)[0])
+        return out
+
