runs/

# large data / model artifacts (downloaded or generated, not source)
data/
tokenizer/

# model checkpoints (belt-and-suspenders: runs/ already ignored, but never
# let a stray checkpoint written elsewhere bloat the repo again)
checkpoints/
consolidated/
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.distcp
*.metadata
tmp_global_ckpts/

# python virtualenvs
.venv/

# rendered animation media (regenerate from viz/*.py)
viz/*.gif
viz/*.mp4

# python bytecode caches
__pycache__/
*.pyc
