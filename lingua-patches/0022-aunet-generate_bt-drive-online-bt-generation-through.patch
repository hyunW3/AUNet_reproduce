@@ -232,32 +225,44 @@ def online_bt_loop(
 
 
 def generate_online_bt(
-    model,
-    regex_pool,
+    generator,
     prompts: List[List[int]],
     bos: int,
     max_gen_len: int,
     *,
-    device: str = "cuda",
     temperature: float = 1.0,
     top_k: Optional[int] = None,
     greedy: bool = False,
     stops: Optional[List[List[int]]] = None,
     eos: Optional[int] = None,
 ):
-    """Real-model entry point: drives `model.forward_logits` with the bt online loop.
+    """Real-model entry point: drives the bt online loop through the generator's
+    variable-length `prefill` (re-run from scratch each step, use_cache=False style).
 
-    `prompts` are raw byte lists (no BOS). `stops` are byte sequences (each a stop string
-    encoded to bytes) that end a row early; `eos` is the eos token id. Returns (out_tokens,
-    out_levels, rollback_counts). Each out_tokens row is `[BOS, b_0, ...]`; strip BOS and
-    any bytes >255 to decode.
+    A fixed [B,T] forward is unusable for generation because the model's position buffers
+    assume the training seq_len; `prefill` is the path that handles arbitrary lengths.
+    Each step we pack the active rows (concatenate tokens + level masks, with per-sequence
+    lengths) and read the per-row last-position logits at `lengths.cumsum-1`.
+
+    `prompts` are raw byte lists (no BOS). `stops` are byte sequences that end a row early;
+    `eos` is the eos token id. Returns (out_tokens, out_levels, rollback_counts); each
+    out_tokens row is `[BOS, b_0, ...]` — strip BOS and bytes >255 to decode.
     """
-    def forward_fn(tok_t, lvl_t):
-        return model.forward_logits(tok_t, lvl_t)
+    device = generator.device
+
+    def forward_fn(token_rows, level_rows, row_ids):
+        flat_tokens = [t for row in token_rows for t in row]
+        flat_levels = [l for row in level_rows for l in row]
+        lengths = torch.tensor([len(r) for r in token_rows], dtype=torch.long, device=device)
+        tok_t = torch.tensor(flat_tokens, dtype=torch.long, device=device).unsqueeze(0)
+        lvl_t = torch.tensor(flat_levels, dtype=torch.long, device=device).unsqueeze(0)
+        logits, _ = generator.prefill(tok_t, lengths, lvl_t)  # (1, total, V)
+        last = lengths.cumsum(0) - 1
+        return logits[0, last]  # (n_rows, V)
 
     return online_bt_loop(
         forward_fn,
-        regex_pool.make_incremental_bt_parser,
+        generator.regex_pool.make_incremental_bt_parser,
         prompts,
         bos,
         max_gen_len,
