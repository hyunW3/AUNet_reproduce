@@ -0,0 +1,245 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+"""
+Online `before_root:bt` autoregressive generation for BPEByte AU-Net models.
+
+Port of spacebyte_feasibility's `SpaceByteBPE._generate_online_bt` (generate branch)
+to the AU-Net hierarchical model. Motivation: AU-Net's stock generator computes patch
+boundaries with `get_levels_mask_gen`, which for a `bpe_*` strategy marks *every*
+generated byte as a boundary (the last char of any prefix is always a BPE token-end),
+so free generation diverges hard from the offline before-root boundaries used in
+training and likelihood eval. This module fixes that with the same mechanism as the
+reference repo:
+
+  full-recompute forward (use_cache=False)
+  + a per-row incremental BPE parser (BPEIncrementalBTParser) that commits boundaries
+    only once stable
+  + speculative-sample-then-rollback: when feeding the just-sampled byte retroactively
+    commits a boundary BEFORE that byte (a `first_pre_t_flip`), the sample was drawn
+    under a now-wrong boundary mask, so we roll the row back to that point (truncate +
+    O(1) parser.restore) and re-sample under the corrected mask.
+
+Because the forward is recomputed from scratch each step, a rollback is just a list
+truncation + re-forward; no KV-cache surgery (the reference repo's commit-point KV
+cache is a separate perf optimization, not required for correctness).
+
+Coordinate convention: tokens are `[BOS, b_0, b_1, ...]`. The parser sees only the raw
+bytes `b_*` (0..255), so a parser emit at byte position `e` maps to token/mask index
+`e + OFFSET` with `OFFSET = 1` (before_root places the boundary on the token's last
+byte; the +1 is the prepended BOS). Index 0 (BOS) is always global — the model's
+`get_pool_mask(force_first=True)` enforces that, and we mark it for clarity.
+
+The core loop takes a `forward_fn(tokens[B,T] long, levels[B,T] long) -> logits[B,T,V]`
+so it is unit-testable on CPU with an injected forward; `generate_online_bt` wraps a
+real `HierarchicalTransformer` via `model.forward_logits`.
+"""
+
+import math
+from typing import Callable, List, Optional
+
+import torch
+import torch.nn.functional as F
+
+# before_root: boundary on the token's last byte (parser offset 0) + 1 for the BOS
+# prepended at token index 0.
+OFFSET = 1
+
+
+def online_bt_loop(
+    forward_fn: Callable[[torch.Tensor, torch.Tensor], torch.Tensor],
+    make_parser: Callable[[], object],
+    prompts: List[List[int]],
+    bos: int,
+    max_gen_len: int,
+    *,
+    device: str = "cpu",
+    temperature: float = 1.0,
+    top_k: Optional[int] = None,
+    greedy: bool = False,
+    max_rollbacks: Optional[int] = None,
+):
+    """Run before_root:bt online generation.
+
+    Args:
+        forward_fn: maps (tokens[B,T] long, levels[B,T] long) -> logits[B,T,V].
+        make_parser: zero-arg factory returning a fresh BPEIncrementalBTParser
+            (i.e. `regex_pool.make_incremental_bt_parser`).
+        prompts: per-row prompt byte lists (raw bytes 0..255, no BOS).
+        bos: BOS token id (prepended at token index 0 of every row).
+        max_gen_len: max NEW bytes to generate per row.
+        greedy: argmax instead of sampling (used by tests / deterministic decode).
+        max_rollbacks: safety cap; defaults to a generous bound.
+
+    Returns:
+        out_tokens: list of per-row token-id lists (each `[BOS, b_0, ...]`).
+        out_levels: list of per-row level lists (0/1 per token position).
+        rollback_counts: per-row rollback counts.
+    """
+    B = len(prompts)
+    # token-length budget: BOS + prompt + generated
+    max_lens = [1 + len(p) + max_gen_len for p in prompts]
+    if max_rollbacks is None:
+        max_rollbacks = max(1000, sum(max_lens) * 64)
+
+    row_tokens: List[List[int]] = []
+    row_levels: List[List[int]] = []
+    parsers = []
+    input_lengths: List[int] = []
+    # snapshots_per_row[b][i] = parser state right after feeding the byte at token index i.
+    snapshots_per_row: List[dict] = []
+
+    for b in range(B):
+        toks = [bos] + [int(x) for x in prompts[b]]
+        levels = [0] * len(toks)
+        levels[0] = 1  # BOS global (force_first also enforces this in the model)
+        parser = make_parser()
+        snaps = {0: parser.snapshot()}
+        input_length = len(toks)
+        # Seed the parser strictly byte-by-byte; the live speculative-tail state at the end
+        # of the prompt must match what subsequent generated bytes will extend (a prompt
+        # ending mid-token leaves that token uncommitted, to be resolved by generation).
+        for j, byte in enumerate(prompts[b]):
+            tok_idx = j + 1  # byte position j -> token index j+1
+            parser.feed(int(byte))
+            cl = parser.committed_levels()
+            for i, lv in enumerate(cl):  # resync committed region (set AND un-set)
+                idx = i + OFFSET
+                if 0 < idx < len(levels):
+                    levels[idx] = 1 if lv > 0 else 0
+            snaps[tok_idx] = parser.snapshot()
+        row_tokens.append(toks)
+        row_levels.append(levels)
+        parsers.append(parser)
+        input_lengths.append(input_length)
+        snapshots_per_row.append(snaps)
+
+    rollback_counts = [0] * B
+    total_rollbacks = 0
+    # Per-(row, token-position) rollback counter. The commit_margin keeps generation from
+    # committing boundaries it must retract, but as a hard backstop against any residual
+    # oscillation we accept-and-advance a position once it has rolled back too many times.
+    pos_rollbacks: List[dict] = [dict() for _ in range(B)]
+    PER_POS_CAP = 16
+
+    with torch.no_grad():
+        while any(len(row_tokens[b]) < max_lens[b] for b in range(B)):
+            cur_len = min(max(len(t) for t in row_tokens), max(max_lens))
+            active = [b for b in range(B) if len(row_tokens[b]) < max_lens[b]]
+
+            tok_cpu = torch.full((B, cur_len), bos, dtype=torch.long)
+            lvl_cpu = torch.zeros((B, cur_len), dtype=torch.long)
+            for b in range(B):
+                n = min(len(row_tokens[b]), cur_len)
+                tok_cpu[b, :n] = torch.tensor(row_tokens[b][:n], dtype=torch.long)
+                lvl_cpu[b, :n] = torch.tensor(row_levels[b][:n], dtype=torch.long)
+            tok_t = tok_cpu.to(device, non_blocking=True)
+            lvl_t = lvl_cpu.to(device, non_blocking=True)
+
+            logits = forward_fn(tok_t, lvl_t)  # (B, cur_len, V)
+
+            # Vectorized sample/argmax across active rows at each row's last real position.
+            ai = torch.tensor(active, dtype=torch.long, device=logits.device)
+            tpos = torch.tensor([len(row_tokens[b]) - 1 for b in active],
+                                dtype=torch.long, device=logits.device)
+            row_logits = logits[ai, tpos]  # (n_active, V)
+            if greedy:
+                nxt = row_logits.argmax(dim=-1)
+            else:
+                rl = row_logits / temperature
+                if top_k is not None and top_k < rl.size(-1):
+                    kth = torch.topk(rl, top_k, dim=-1).values[:, -1:]
+                    rl = rl.masked_fill(rl < kth, -math.inf)
+                nxt = torch.multinomial(F.softmax(rl, dim=-1), num_samples=1).squeeze(-1)
+            nxt_cpu = nxt.tolist()
+
+            for i_b, b in enumerate(active):
+                t = len(row_tokens[b])  # token index the new byte will occupy
+                next_token = int(nxt_cpu[i_b])
+                row_tokens[b].append(next_token)
+                row_levels[b].append(0)
+                parsers[b].feed(next_token)
+                input_length = input_lengths[b]
+
+                # Resync the mask over the committed region from the parser's authoritative
+                # view (handles backward re-merges that RETRACT a previously-committed
+                # boundary, not just additions). Track the FIRST token index strictly
+                # before t whose boundary value CHANGED: only such a change makes the
+                # just-sampled byte (drawn from logits depending on mask[0:t]) off-policy.
+                # A change exactly at t affects only future samples; a re-confirmation of
+                # an already-correct boundary is a no-op and must NOT roll back (else a
+                # parser parked in a live descent loops until the rollback cap).
+                committed = parsers[b].committed_levels()
+                first_change = None
+                for i, lv in enumerate(committed):
+                    idx = i + OFFSET
+                    if 0 < idx < len(row_levels[b]):
+                        want = 1 if lv > 0 else 0
+                        if row_levels[b][idx] != want:
+                            row_levels[b][idx] = want
+                            if idx < t and first_change is None:
+                                first_change = idx
+
+                if first_change is None:
+                    snapshots_per_row[b][t] = parsers[b].snapshot()
+                    continue
+
+                keep = max(first_change + 1, input_length)
+                if keep > t:
+                    snapshots_per_row[b][t] = parsers[b].snapshot()
+                    continue
+
+                # Backstop: if this position has rolled back too many times, accept the byte
+                # under the current mask and advance rather than loop. Rare with margin=2.
+                pos_rollbacks[b][t] = pos_rollbacks[b].get(t, 0) + 1
+                if pos_rollbacks[b][t] > PER_POS_CAP:
+                    snapshots_per_row[b][t] = parsers[b].snapshot()
+                    continue
+
+                # Roll back: drop the off-policy byte(s) after `keep`, restore the parser
+                # to the kept-prefix state (O(1)), and re-sample under the corrected mask.
+                # row_levels[:keep] retains the corrected boundary at keep-1, so the
+                # re-sampled byte sees the right mask and converges.
+                row_tokens[b] = row_tokens[b][:keep]
+                row_levels[b] = row_levels[b][:keep]
+                parsers[b].restore(snapshots_per_row[b][keep - 1])
+                for k in [k for k in snapshots_per_row[b] if k >= keep]:
+                    del snapshots_per_row[b][k]
+                total_rollbacks += 1
+                rollback_counts[b] += 1
+                if total_rollbacks > max_rollbacks:
+                    raise RuntimeError("Exceeded rollback cap during bt online generation")
+
+    return row_tokens, row_levels, rollback_counts
+
+
+def generate_online_bt(
+    model,
+    regex_pool,
+    prompts: List[List[int]],
+    bos: int,
+    max_gen_len: int,
+    *,
+    device: str = "cuda",
+    temperature: float = 1.0,
+    top_k: Optional[int] = None,
+    greedy: bool = False,
+):
+    """Real-model entry point: drives `model.forward_logits` with the bt online loop.
+
+    `prompts` are raw byte lists (no BOS). Returns (out_tokens, out_levels,
+    rollback_counts). Each out_tokens row is `[BOS, b_0, ...]`; strip BOS and any bytes
+    >255 to decode.
+    """
+    def forward_fn(tok_t, lvl_t):
+        return model.forward_logits(tok_t, lvl_t)
+
+    return online_bt_loop(
+        forward_fn,
+        regex_pool.make_incremental_bt_parser,
+        prompts,
+        bos,
+        max_gen_len,
+        device=device,
+        temperature=temperature,
+        top_k=top_k,
+        greedy=greedy,
+    )
diff --git a/apps/aunet/hierarchical.py b/apps/aunet/hierarchical.py
index 7501eb7..5576c5f 100644
--- a/apps/aunet/hierarchical.py
+++ b/apps/aunet/hierarchical.py
@@ -524,6 +524,39 @@ class HierarchicalTransformer(nn.Module):
         self.num_params = [get_num_params(e) for e in self.encoders]
         self.num_params += [get_num_params(self.trunk)]
 
+    def forward_logits(
+        self,
+        token_values: torch.Tensor,  # bsz, seqlen
+        level_mask: torch.Tensor,  # bsz, seqlen
+    ) -> torch.Tensor:
+        """Non-cached full forward returning per-position logits (bsz, seqlen, vocab).
+
+        Same encoder->trunk->decoder->vocab path as `forward`, but without targets/loss.
+        Used by apps/aunet/generate_bt.py for `before_root:bt` online generation, which
+        recomputes the whole sequence each step (use_cache=False) so a rollback is just a
+        truncation + re-forward — mirroring spacebyte_feasibility's `_generate_online_bt`.
+        """
+        masks, _, _ = self.get_pool_mask(
+            level_mask,
+            [e.max_seqlen for e in self.encoders] + [self.trunk.max_seqlen],
+            return_idcs=False,
+            force_first=True,
+        )
+        residuals = []
+        x = self.tok_embeddings(token_values)
+        for encoder, trans, mask in zip(self.encoders, self.transitions, masks):
+            x = encoder(x, attn_impl="fmha")
+            residuals.append(x)
+            x = trans.down(x, mask, encoder.rope_embeddings.freqs_cis)
+        x = self.trunk(x, attn_impl="fmha")
+        it = list(zip(self.decoders, self.transitions, residuals, self.adding_residuals, masks))[::-1]
+        for decoder, trans, res, add_res, mask in it:
+            x = trans.up(x, res, mask, decoder.rope_embeddings.freqs_cis)
+            if add_res:
+                x = res + x
+            x = decoder(x, attn_impl="fmha")
+        return self.vocab(self.vocab_norm(x))
+
     def forward(
         self,
         token_values: torch.Tensor,  # bsz, seqlen
