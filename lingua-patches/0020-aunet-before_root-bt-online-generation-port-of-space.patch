+# Copyright (c) Meta Platforms, Inc. and affiliates.
+"""
+Tests for before_root:bt online generation (apps/aunet/generate_bt.py) and the
+incremental parser interface it relies on (BPEIncrementalBTParser).
+
+Run:  python -m apps.aunet.test_generate_bt
+(uses a CPU forward that FORCES a known target byte string, so it exercises the
+rollback machinery without a GPU/model and checks the reconstructed patch
+boundaries against the offline get_levels_mask.)
+"""
+import random
+
+import torch
+
+from apps.aunet.data.regex_cutting import RegexPool, RegexArgs
+from apps.aunet.generate_bt import online_bt_loop
+
+TOK = "/NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/tokenizer/llama3/tokenizer.model"
+BOS = 256
+V = 512
+
+
+def _pool():
+    return RegexPool(RegexArgs(strategy={"bpe_br": "1@1"}, bpe_tokenizer_path=TOK))
+
+
+def test_parser_feed_finalize_matches_offline():
+    pool = _pool()
+    rng = random.Random(0)
+    for _ in range(50):
+        s = bytes(rng.randint(97, 122) if rng.random() > 0.2 else 32
+                  for _ in range(rng.randint(5, 80)))
+        fb = list(s)
+        off = pool.get_levels_mask(fb)
+        p = pool.make_incremental_bt_parser()
+        for b in fb:
+            p.feed(b)
+        assert p.finalize() == off, f"finalize != offline for {s!r}"
+
+
+def test_parser_snapshot_restore_roundtrip():
+    pool = _pool()
+    fb = list(b"The quick brown fox jumps over")
+    p = pool.make_incremental_bt_parser()
+    for b in fb[:15]:
+        p.feed(b)
+    snap = p.snapshot()
+    state = (list(p.buf), list(p.levels), p._committed)
+    for b in fb[15:25]:
+        p.feed(b)
+    p.restore(snap)
+    assert (p.buf, p.levels, p._committed) == state
+
+
+def test_committed_is_subset_of_offline():
+    pool = _pool()
+    for s in [b"hello world foo bar", b"The quick brown", b"aaa bbb ccc"]:
+        fb = list(s)
+        off = {i for i, v in enumerate(pool.get_levels_mask(fb)) if v > 0}
+        p = pool.make_incremental_bt_parser()
+        for b in fb:
+            p.feed(b)
+        committed = {i for i, v in enumerate(p.committed_levels()) if v > 0}
+        assert committed.issubset(off), f"committed not subset of offline for {s!r}"
+
+
+def _forced_forward(targets):
+    """A forward that forces argmax at each position to the next target token."""
+    def forward_fn(tok_t, lvl_t):
+        B, T = tok_t.shape
+        logits = torch.full((B, T, V), -10.0)
+        for b in range(B):
+            for p in range(T):
+                nxt = targets[b][p + 1] if p + 1 < len(targets[b]) else targets[b][-1]
+                logits[b, p, nxt] = 10.0
+        return logits
+    return forward_fn
+
+
+def _check_gen(pool, text, prompt=""):
+    pb = list(prompt.encode())
+    cb = list(text.encode())
+    full = pb + cb
+    target = [BOS] + full
+    off_b = {i for i, v in enumerate(pool.get_levels_mask(target)) if v > 0 and i >= 1}
+    toks, lvls, rb = online_bt_loop(
+        _forced_forward([target]), pool.make_incremental_bt_parser,
+        [pb], BOS, max_gen_len=len(cb), greedy=True)
+    gen = toks[0][1:]
+    gb = {i for i, v in enumerate(lvls[0]) if v > 0 and i >= 1}
+    frontier = max(gb) if gb else 0
+    assert gen == full, f"bytes mismatch for {text!r}"
+    assert gb.issubset(off_b), f"spurious boundary for {text!r}"
+    # committed boundaries gap-free up to the frontier (only the trailing speculative
+    # tokens, held by commit_margin, are absent)
+    assert {i for i in off_b if i <= frontier} == gb, f"boundary gap for {text!r}"
+    return rb[0]
+
+
+def test_forced_generation_reconstructs_offline_boundaries():
+    pool = _pool()
+    cases = [
+        "The quick brown fox", "hello world foo bar", "abcdefg hijk",
+        "aaa bbb ccc ddd eee", "tokenization is hard",
+        "12345 67890 mixed Case TEXT", "supercalifragilistic expialidocious",
+        "The cat sat on the mat near the door",
+    ]
+    for t in cases:
+        _check_gen(pool, t)
+    for p, t in [("The quick ", "brown fox jumps"), ("def foo(x): ", "return x + 1")]:
+        _check_gen(pool, t, p)
+
+
+def test_batch_generation():
+    pool = _pool()
+    texts = ["hello world", "The quick brown fox jumps", "ab cd ef"]
+    targets = [[BOS] + list(t.encode()) for t in texts]
+    toks, lvls, rb = online_bt_loop(
+        _forced_forward(targets), pool.make_incremental_bt_parser,
+        [[], [], []], BOS, max_gen_len=max(len(t.encode()) for t in texts), greedy=True)
+    for b, t in enumerate(texts):
+        full = list(t.encode())
+        off_b = {i for i, v in enumerate(pool.get_levels_mask([BOS] + full)) if v > 0 and i >= 1}
+        gen = toks[b][1:1 + len(full)]
+        gb = {i for i, v in enumerate(lvls[b]) if v > 0 and 1 <= i <= len(full)}
+        frontier = max(gb) if gb else 0
+        assert gen == full
+        assert gb.issubset(off_b)
+        assert {i for i in off_b if i <= frontier} == gb
