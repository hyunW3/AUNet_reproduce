+    # ------------------------------------------------------------------ #
+    # Online-generation interface (mirrors spacebyte_feasibility's        #
+    # IncrementalTrieTokenizer: feed / snapshot / restore / pos_at_root). #
+    # Used by apps/aunet/generate_bt.py for before_root:bt generation.    #
+    # ------------------------------------------------------------------ #
+    @property
+    def pos_at_root(self) -> int:
+        """Start of the still-growing (speculative) token = first uncommitted byte
+        position. Snapshots strictly below this can be GC'd: the committed region
+        never changes again, so they can never be a rollback target."""
+        return self._committed
+
+    def feed(self, byte: int) -> int:
+        """Append one byte and re-stabilize. Returns the new committed length
+        (`self._committed`). The authoritative committed boundary view is then
+        `committed_levels()` — read it after every feed rather than accumulating the
+        return value: `_recompute` can RETRACT a boundary inside the committed region
+        when a later byte triggers a backward BPE re-merge (e.g. "hello wor"->"world"
+        moves the boundary off the 'r'), so the committed set changes in both
+        directions. The online generation loop resyncs its mask from
+        `committed_levels()` each step and rolls back on the earliest change before the
+        sampled byte."""
+        self.buf.append(byte)
+        self._recompute(final=False)
+        return self._committed
+
+    def committed_levels(self) -> List[int]:
+        """Authoritative per-byte level list over the committed region [0, _committed).
+        Boundaries here match the offline `get_levels_mask` of the full sequence
+        restricted to this region (verified); the still-growing final token is excluded."""
+        return list(self.levels[:self._committed])
+
+    def snapshot(self) -> Any:
+        """O(window) copy of parser state for O(1) rollback (vs reset()+replay)."""
+        return (list(self.buf), list(self.levels), self._committed)
+
+    def restore(self, snap: Any) -> None:
+        buf, levels, committed = snap
+        self.buf = list(buf)
+        self.levels = list(levels)
+        self._committed = committed
