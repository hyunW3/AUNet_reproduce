+import math
 import os
+
+# Byte models generate bytes, but lm-eval counts subword tokens. Scale generation-length
+# budgets by this many bytes per token so generated answers are not truncated (DCLM ~4.8;
+# rounded up for headroom). Tunable if the truncation guard in generate_until fires.
+GEN_BYTES_PER_TOKEN = 6
 from pathlib import Path
 from lm_eval.api.instance import Instance
 from lm_eval.api.model import LM
@@ -125,25 +131,112 @@ class EvalHarnessLM(LM):
         return self.accelerator.gather(tensor)
 
     def generate_until(self, requests: List[Instance]) -> List[str]:
-        prompts, gen_args = zip(*[req.args for req in requests])
-        assert all_dicts_same(gen_args), "Doesn't support different gen args for now"
-        gen_args = gen_args[0]
-        temperature = gen_args.get("temperature", 0.0)
-        top_p = gen_args.get("top_p", None)
-        top_k = gen_args.get("top_k", None)
-        until = gen_args.get("until", [])
-
-        self.generator.temperature = temperature
-        self.generator.top_p = top_p
-        self.generator.top_k = top_k
-        self.generator.until = until
-        generations, _, _ = self.generator.generate(prompts)
-        filtered_gen = []
-        for g in generations:
-            for e in until:
-                g = g.replace(e, "")
-            filtered_gen.append(g)
-        return filtered_gen
+        # lm-eval batches generate_until requests from MANY tasks together, each with its
+        # own gen args (until, max_gen_toks, sampling). Group by gen args and generate each
+        # group with its own settings, then reassemble in the original request order.
+        results: List[Optional[str]] = [None] * len(requests)
+        groups = defaultdict(list)  # gen-arg key -> [(orig_idx, prompt)]
+        gen_args_by_key = {}
+        for i, req in enumerate(requests):
+            prompt, ga = req.args
+            key = json.dumps(
+                {k: ga.get(k) for k in ("until", "temperature", "top_p", "top_k", "max_gen_toks", "do_sample")},
+                sort_keys=True, default=str,
+            )
+            groups[key].append((i, prompt))
+            gen_args_by_key[key] = ga
+        # BPEByte (any `bpe_*` patch strategy): the stock cached generator marks every
+        # generated byte as a patch boundary (get_levels_mask_gen), diverging from the
+        # offline before-root boundaries the model trained on. Route generation through the
+        # backtracking online loop (apps/aunet/generate_bt.py) so generation-based downstream
+        # evals see the correct patch structure. Word-strategy models keep the stock path.
+        strat = getattr(self.generator.regex_pool, "strategy", {}) or {}
+        if any(str(k).startswith("bpe") for k in strat):
+            return self._generate_until_bt(requests, groups, gen_args_by_key)
+        for key, items in groups.items():
+            ga = gen_args_by_key[key]
+            until = ga.get("until", [])
+            # Honor lm-eval's per-task generation length so answers are not truncated.
+            # BYTE model: lm-eval counts subword tokens, but we generate bytes (~5-6 bytes/
+            # token on DCLM), so scale up or the answer is cut short. The generator's
+            # max_gen_len setter additionally x2's the value (apps/aunet/generate.py), so we
+            # divide by 2 to land at GEN_BYTES_PER_TOKEN effective bytes per requested token.
+            max_gen_toks = ga.get("max_gen_toks", 256)
+            self.generator.max_gen_len = math.ceil(max_gen_toks * GEN_BYTES_PER_TOKEN / 2)
+            self.generator.temperature = ga.get("temperature", 0.0)
+            self.generator.top_p = ga.get("top_p", None)
+            self.generator.top_k = ga.get("top_k", None)
+            self.generator.until = until
+            # CRITICAL: max_until_size is set once in the generator __init__ (when until was
+            # empty -> 1) and is NOT recomputed when until changes. Without this, the stop-
+            # detection window is 1 byte, so multi-char stops ("Question:", "\n\n") never match
+            # and the byte model never stops -> rambles to max_gen_len (truncation). Recompute it.
+            self.generator.max_until_size = max((len(e) for e in until), default=1)
+            prompts = [p for _, p in items]
+            gens, _, _ = self.generator.generate(prompts)
+            # Truncation guard: with stop sequences, a generation containing none of them
+            # almost certainly hit max_gen_len (answer truncated) -> raise GEN_BYTES_PER_TOKEN.
+            if until:
+                n_trunc = sum(1 for g in gens if not any(e in g for e in until))
+                if n_trunc:
+                    logger.warning(
+                        f"generate_until: {n_trunc}/{len(gens)} byte-generations reached "
+                        f"max_gen_len without a stop sequence (possible answer truncation; "
+                        f"max_gen_toks={max_gen_toks}, bytes/token={GEN_BYTES_PER_TOKEN})"
+                    )
+            for (idx, _), g in zip(items, gens):
+                for e in until:
+                    g = g.replace(e, "")
+                results[idx] = g
+        return results
+
+    def _generate_until_bt(self, requests, groups, gen_args_by_key) -> List[str]:
+        """generate_until for BPEByte models via the backtracking online loop.
+
+        Mirrors spacebyte_feasibility's `_model_generate` override: route generation to the
+        bt loop so the patch boundaries match training. Same gen-arg grouping + byte-length
+        scaling + stop handling as the stock path; stops are honored inside the loop (early
+        exit) and the answer is truncated at the first stop string."""
+        from apps.aunet.generate_bt import generate_online_bt
+
+        tok = self.generator.tokenizer
+        results: List[Optional[str]] = [None] * len(requests)
+        for key, items in groups.items():
+            ga = gen_args_by_key[key]
+            until = ga.get("until", []) or []
+            # byte budget: lm-eval counts subword tokens; scale to bytes (~GEN_BYTES_PER_TOKEN
+            # per token). No /2 here — generate_online_bt takes bytes directly (no setter x2).
+            max_gen_toks = ga.get("max_gen_toks", 256)
+            max_gen_len = math.ceil(max_gen_toks * GEN_BYTES_PER_TOKEN)
+            temperature = ga.get("temperature", 0.0) or 0.0
+            top_k = ga.get("top_k", None)
+            greedy = (ga.get("do_sample") is False) or temperature == 0.0
+
+            prompt_bytes = [tok.encode(p, add_bos=False, add_eos=False) for _, p in items]
+            stop_bytes = [tok.encode(s, add_bos=False, add_eos=False) for s in until]
+            out_tokens, _, _ = generate_online_bt(
+                self.generator.model, self.generator.regex_pool, prompt_bytes,
+                tok.bos_id, max_gen_len, device=self.generator.device,
+                temperature=max(temperature, 1e-6), top_k=top_k, greedy=greedy,
+                stops=stop_bytes, eos=tok.eos_id,
+            )
+            n_trunc = 0
+            for (idx, _), toks_row, pb in zip(items, out_tokens, prompt_bytes):
+                gen = toks_row[1 + len(pb):]  # strip BOS + prompt
+                gen = [b for b in gen if 0 <= b < 256]  # drop eos / special ids
+                text = bytes(gen).decode("utf-8", errors="replace")
+                cut = min([text.find(e) for e in until if e and e in text] or [-1])
+                if cut != -1:
+                    text = text[:cut]
+                elif until:
+                    n_trunc += 1
+                results[idx] = text
+            if until and n_trunc:
+                logger.warning(
+                    f"generate_until[bt]: {n_trunc}/{len(items)} generations hit max_gen_len "
+                    f"without a stop (possible truncation; max_gen_toks={max_gen_toks})"
+                )
+        return results
 
     def loglikelihood(self, requests: List[Instance]) -> List[Tuple[float, bool]]:
         prompts, continuations = zip(*[req.args for req in requests])
