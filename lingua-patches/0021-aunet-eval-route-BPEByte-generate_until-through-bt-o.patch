+def test_stop_and_eos_early_exit():
+    pool = _pool()
+    EOS = 257
+    # stop sequence halts generation right after the stop string
+    text = "answer is 42\n\nignored tail that must not appear"
+    target = [BOS] + list(text.encode())
+    stop = list("\n\n".encode())
+    toks, _, _ = online_bt_loop(
+        _forced_forward([target]), pool.make_incremental_bt_parser,
+        [[]], BOS, max_gen_len=len(text.encode()), greedy=True, stops=[stop])
+    gen = bytes(b for b in toks[0][1:] if b < 256).decode()
+    assert gen.endswith("\n\n") and "ignored" not in gen, f"stop not honored: {gen!r}"
+    # eos halts generation before max_gen_len
+    target2 = [BOS] + list(b"hello") + [EOS]
+    toks2, _, _ = online_bt_loop(
+        _forced_forward([target2]), pool.make_incremental_bt_parser,
+        [[]], BOS, max_gen_len=50, greedy=True, eos=EOS)
+    assert len(toks2[0]) < 50, "eos did not stop generation early"
+
