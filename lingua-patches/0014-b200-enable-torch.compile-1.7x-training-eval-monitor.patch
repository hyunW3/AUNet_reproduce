diff --git a/apps/main/train.py b/apps/main/train.py
index 42c5fe5..92a1c0b 100644
--- a/apps/main/train.py
+++ b/apps/main/train.py
@@ -428,13 +428,28 @@ def train(args: TrainArgs):
             # optimizer step
             grad_norm = -1.0
             if train_state.acc_step == 0:
-                grad_norm = torch.nn.utils.clip_grad_norm_(
-                    model.parameters(), max_norm=args.optim.clip, foreach=True
+                # Fully manual DTensor-safe clip: torch 2.7.0 + FSDP2's DTensor
+                # `full_tensor()`/`redistribute` call into functional all_reduce that
+                # fails `get_group_info` lookup in this env (cu128 build), and the
+                # traced collective also breaks under torch.compile.
+                # Bypass by extracting local tensors and doing one explicit all_reduce.
+                _grads = [p.grad for p in model.parameters() if p.grad is not None]
+                _local_sumsq = torch.zeros((), device=_grads[0].device, dtype=torch.float32)
+                for _g in _grads:
+                    _gl = _g.to_local() if isinstance(_g, DTensor) else _g
+                    _local_sumsq += _gl.detach().float().pow(2).sum()
+                if torch.distributed.is_initialized():
+                    torch.distributed.all_reduce(
+                        _local_sumsq, op=torch.distributed.ReduceOp.SUM
+                    )
+                total_norm = _local_sumsq.sqrt()
+                clip_coef = torch.clamp(
+                    args.optim.clip / (total_norm + 1e-6), max=1.0
                 )
-
-                grad_norm = (
-                    grad_norm.full_tensor() if isinstance(grad_norm, DTensor) else grad_norm
-                ).item()
+                for _g in _grads:
+                    _gl = _g.to_local() if isinstance(_g, DTensor) else _g
+                    _gl.mul_(clip_coef.to(_gl.dtype))
+                grad_norm = total_norm.item()
 
                 optimizer.step()
                 scheduler.step()
diff --git a/monitor_llama_milestones.sh b/monitor_llama_milestones.sh
new file mode 100755
index 0000000..b8a8262
--- /dev/null
+++ b/monitor_llama_milestones.sh
@@ -0,0 +1,59 @@
+#!/bin/bash
+# Watches the llama_1B training log and fires alert_knock (Telegram) at 30/60/100%
+# of total steps. Also alerts if the training process dies before 100%.
+# Reads the CURRENT step from the tail of train.log (the resumed run appends to it),
+# so it is robust to the old pre-resume lines still present in the file.
+# Launch detached:  setsid nohup bash monitor_llama_milestones.sh >monitor.out 2>&1 &
+
+TRAINLOG=/NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/runs/llama_1B_dm10/train.log
+KNOCK=/NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/alert_knock
+PROC="apps.main.train"
+TOTAL=30800
+POLL=60
+EVAL_SH=/NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/lingua/run_eval_llama.sh
+EVAL_OUT=/NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/runs/llama_1B_dm10/eval.out
+
+# "pct:threshold_step"
+MILESTONES="30:9240 60:18480 100:30800"
+declare -A FIRED
+
+notify() {  # $1=pct $2=current_step
+    "$KNOCK" echo "llama_1B training ${1}% reached — step ${2}/${TOTAL}" >/dev/null 2>&1
+    echo "$(date '+%F %T') fired ${1}% at step ${2}"
+}
+
+echo "$(date '+%F %T') monitor started; total=${TOTAL}; milestones=${MILESTONES}"
+while true; do
+    cur=$(grep -aoE "step: [0-9]+" "$TRAINLOG" 2>/dev/null | tail -1 | grep -oE "[0-9]+")
+    [ -z "$cur" ] && cur=0
+
+    for m in $MILESTONES; do
+        pct=${m%%:*}; thr=${m##*:}
+        if [ -z "${FIRED[$pct]}" ] && [ "$cur" -ge "$thr" ]; then
+            notify "$pct" "$cur"
+            FIRED[$pct]=1
+        fi
+    done
+
+    # 100% reached: wait for the training process to fully exit (it runs its own
+    # in-process final eval first) so the standalone eval doesn't contend for GPUs,
+    # then launch the downstream eval detached, wrapped in alert_knock for a Telegram
+    # notification on completion.
+    if [ -n "${FIRED[100]}" ]; then
+        echo "$(date '+%F %T') 100% reached; waiting for training process to exit before eval"
+        while pgrep -f "$PROC" >/dev/null; do sleep 30; done
+        echo "$(date '+%F %T') training exited; launching downstream eval"
+        setsid nohup "$KNOCK" bash "$EVAL_SH" > "$EVAL_OUT" 2>&1 < /dev/null &
+        echo "$(date '+%F %T') eval launched (log: $EVAL_OUT); exiting monitor"
+        break
+    fi
+
+    # If training stopped before reaching 100%, alert once and exit
+    if ! pgrep -f "$PROC" >/dev/null; then
+        "$KNOCK" echo "llama_1B training STOPPED at step ${cur}/${TOTAL} before 100% — check the run" >/dev/null 2>&1
+        echo "$(date '+%F %T') training process gone at step ${cur}; exiting"
+        break
+    fi
+
+    sleep "$POLL"
+done
