+#!/bin/bash
+cd /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/lingua
+source .venv/bin/activate
+
+# torch.compile requires a short + exec-capable TMPDIR:
+#   - /tmp is mounted noexec here -> compiled .so fails to mmap ("failed to map segment")
+#   - the long lustre workspace path overflows the AF_UNIX socket limit (108 chars)
+# /var/tmp is short and exec-capable. The trainer derives TRITON_CACHE_DIR from TMPDIR.
+export TMPDIR=/var/tmp
+
+model_path=/NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/runs/bpebyte_br_bt_1.3B/checkpoints
+
+# lingua auto-resumes from the latest checkpoint in dump_dir/checkpoints
+# (train.py defaults checkpoint.path to dump_dir/checkpoints, and the checkpoint
+# manager loads the newest step at startup). There is no ckpt_dir CLI arg.
+LATEST=$(find "$model_path" -mindepth 1 -maxdepth 1 -type d -printf "%f\n" 2>/dev/null | sort -n | tail -1)
+if [ -n "$LATEST" ]; then
+    echo "Will auto-resume from: ${model_path}/${LATEST}"
+else
+    echo "No checkpoint found under ${model_path}; starting fresh."
+fi
+
+# 4-GPU single-node training (matches dp_replicate: 4 in the config). BPEByte br_bt =
+# AU-Net hierarchical model + llama3 BPE patch boundaries (runs through apps.aunet.train).
+torchrun --nproc-per-node 4 --master-port 29504 -m apps.aunet.train \
+    config=apps/aunet/configs/bpebyte_br_bt_1.3B.yaml
