+name: "bpebyte_br_bt_1.3B"
+steps: 180000
+grad_acc_steps: 4
+probe_freq: null
+
+seed: 777
+optim:
+    lr: 1.65e-3
+    warmup: 10000
+    weight_decay: 0.1
+    lr_min_ratio: 0.01
+    clip: 0.2
+
+distributed:
+    fsdp_type: full_shard
+    compile: true  # same B200 setup as AU-Net; needs TMPDIR=/var/tmp (train_bpebyte.sh sets it)
+    model_dtype: bf16
+    matmul_allow_tf32: false
+    selective_activation_checkpointing: false
+    tp_size: 1
+    compile_cache_size_limit: 16
+
+model:
+    dimensions: [512, 2048]
+    layers: [3, 25]
+    head_dims: [64, 128]
+    residuals: [True]
+    sliding_windows: [512, 4096]
+    max_seqlens: [-1, 3200]
