new file mode 100644
index 0000000..5507d12
--- /dev/null
+++ b/lingua/eval_milestones.py
@@ -0,0 +1,28 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+"""Shared helper for triggering mid-training downstream evals at fixed fractions of
+the total training schedule (e.g. 30/60/90/100%). Used by every model app
+(apps/aunet, apps/main, ...) so the milestone logic stays identical across them.
+"""
+from typing import List, Optional, Sequence
+
+DEFAULT_EVAL_MILESTONES: Sequence[float] = (0.30, 0.60, 0.90, 1.0)
+
+
+def milestone_steps(total_steps: int, fracs: Optional[Sequence[float]] = None) -> List[int]:
+    """Absolute step numbers for the given fractions of `total_steps`.
+
+    Deduplicated and sorted; each clamped to [1, total_steps].
+    """
+    if fracs is None:
+        fracs = DEFAULT_EVAL_MILESTONES
+    steps = {min(max(1, round(total_steps * f)), total_steps) for f in fracs}
+    return sorted(steps)
+
+
+def is_milestone(
+    step: int, total_steps: int, fracs: Optional[Sequence[float]] = None
+) -> bool:
+    """True if `step` is one of the milestone steps for `total_steps`."""
+    if not fracs:
+        return False
+    return step in set(milestone_steps(total_steps, fracs))
