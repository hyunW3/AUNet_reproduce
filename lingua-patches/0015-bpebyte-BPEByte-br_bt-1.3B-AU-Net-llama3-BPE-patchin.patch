+    load_async: true
+    add_bos: true
+    add_eos: true
+    tokenizer:
+        name: bytes
+    # BPEByte patching: boundaries = end of each llama3 BPE token (instead of word1).
+    regex:
+        strategy:
+            bpe_br: 1@1
+        bpe_tokenizer_path: /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/tokenizer/llama3/tokenizer.model
