+
+class BPEIncrementalBTParser:
+    """Backtracking streaming parser for BPEByte `:bt` generation.
+
+    Feed bytes one at a time with `step(byte)`. Internally it re-tokenizes a bounded suffix
+    window of the byte buffer with the llama3 BPE tokenizer each step and **commits** patch
+    boundaries only for token-ends that are stable — every token-end except the last (the
+    final token may still grow/merge as more bytes arrive). `step()` returns the boundary
+    positions that became committed on this byte (possibly referring to earlier positions,
+    i.e. a retroactive correction = backtracking). `finalize()` commits the trailing token.
+
+    Invariant (verified): after `finalize()`, `self.levels` equals the offline
+    `RegexPool.get_levels_mask(full_bytes)` for the same byte sequence.
+
+    Note: integrating retroactive corrections into `PackedHierarchicalCausalTransformerGenerator`
+    requires the generator to re-pool revised tail patches; that wiring is a follow-up. The
+    parser itself (this class) is the reusable component.
+    """
+
+    def __init__(self, pool: "RegexPool", window: int = 4096):
+        assert pool.bpe_tokenizer is not None
+        self.pool = pool
+        self.window = window
+        self.buf: List[int] = []
+        self.levels: List[int] = []   # committed pooling level per byte position
+        self._committed = 0           # number of byte positions whose level is finalized
+
+    def _recompute(self, final: bool) -> None:
+        while len(self.levels) < len(self.buf):
+            self.levels.append(0)
+        start = max(0, len(self.buf) - self.window)
+        lm = self.pool.get_levels_mask(self.buf[start:])
+        ends_local = [i for i, v in enumerate(lm) if v > 0]
+        if not ends_local:
+            return
+        # Stable region = everything up to (and including) the last token-end, EXCEPT the
+        # final token which may still grow as more bytes arrive (unless this is finalize()).
+        stable_upper_local = len(lm) if final else ends_local[-1]  # exclusive bound
+        # Authoritatively rewrite the in-window stable region (true backtracking: a position
+        # that is no longer a token-end after later merges gets reset to 0).
+        for i in range(start, start + stable_upper_local):
+            if i < len(self.levels):
+                self.levels[i] = lm[i - start]
+        self._committed = max(self._committed, start + stable_upper_local)
+
+    def step(self, byte: int):
+        """Append one byte; return list of (abs_position, level) for the in-window stable
+        region, reflecting any retroactive (backtracked) revisions made on this byte."""
+        self.buf.append(byte)
+        start = max(0, len(self.buf) - self.window)
+        self._recompute(final=False)
+        return [(i, self.levels[i]) for i in range(start, self._committed) if self.levels[i] > 0]
+
+    def finalize(self) -> List[int]:
+        """Commit the trailing (last) token's boundary; return the full per-byte level list."""
+        self._recompute(final=True)
+        return list(self.levels)
