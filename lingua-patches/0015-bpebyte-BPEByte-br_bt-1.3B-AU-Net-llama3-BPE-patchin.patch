+    def _bpe_end_offsets(self, text: str) -> List[int]:
+        """Character index of the LAST character of each llama3 BPE token.
+
+        This is the "before_root" (br) boundary placement: the patch boundary sits on the
+        final character of each BPE token, mirroring the word strategy's `match.end()-1`.
+        Returns a strictly-ascending list of char indices in [0, len(text)-1]; tokens that
+        split a single multibyte character collapse onto one boundary.
+        """
+        if not text:
+            return []
+        # get_token_offsets returns the START char offset of each token (with split-char
+        # correction). The end char of token i is start[i+1]-1; the last token ends at len-1.
+        _, start_offsets = self.bpe_tokenizer.get_token_offsets(text)
+        n = len(text)
+        end_offsets = [start_offsets[j + 1] - 1 for j in range(len(start_offsets) - 1)]
+        end_offsets.append(n - 1)
+        out: List[int] = []
+        prev = -1
+        for o in end_offsets:
+            o = min(max(o, 0), n - 1)
+            if o > prev:
+                out.append(o)
+                prev = o
