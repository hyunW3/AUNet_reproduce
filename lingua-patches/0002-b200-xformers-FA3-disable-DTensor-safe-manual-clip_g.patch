From aa0e48753b171e83ad46beb4d81bd3a8510a3569 Mon Sep 17 00:00:00 2001
From: hyunW3 <0176778602@naver.com>
Date: Sat, 23 May 2026 14:26:57 +0900
Subject: [PATCH 02/22] b200: xformers FA3 disable + DTensor-safe manual
 clip_grad
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two B200-related fixes that need to land together with the new train.py:

1) xformers 0.0.30 ships flash-attention v3 kernels compiled only for
   sm_90 (Hopper). On B200 (sm_100), the bundled .so raises:
     CUDA error: no kernel image is available for execution on the device
   Workaround: call _set_use_fa3(False) at import time in train.py and
   eval.py so xformers dispatches to flash2 / cutlass instead.

2) torch 2.7.0+cu128 + FSDP2's DTensor 'full_tensor()' / 'redistribute'
   call into functional all_reduce that fails get_group_info lookup
   when ENABLE_INTRA_NODE_COMM=1 (see follow-up commit). Even after
   that fix, the standard clip_grad_norm_ + DTensor combo is fragile,
   so replace it with a fully manual L2 norm + torch.distributed
   all_reduce + scale via to_local() — all DTensor-free.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 apps/aunet/eval.py  |  3 +++
 apps/aunet/train.py | 30 ++++++++++++++++++++++++------
 2 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/apps/aunet/eval.py b/apps/aunet/eval.py
index a33b948..916dda6 100644
--- a/apps/aunet/eval.py
+++ b/apps/aunet/eval.py
@@ -13,6 +13,9 @@ from typing import Any, List, Optional, Tuple, Union
 from lm_eval import simple_evaluate
 from omegaconf import OmegaConf
 import torch
+# B200/Blackwell (sm_100): disable xformers flash-attn3 (sm_90 only kernels in 0.0.30)
+from xformers.ops.fmha.dispatch import _set_use_fa3 as _xfmr_set_use_fa3
+_xfmr_set_use_fa3(False)
 from apps.aunet.generate import (
     PackedHierarchicalCausalTransformerGenerator,
     PackedHierarchicalCausalTransformerGeneratorArgs,
diff --git a/apps/aunet/train.py b/apps/aunet/train.py
index c509f5e..c125336 100644
--- a/apps/aunet/train.py
+++ b/apps/aunet/train.py
@@ -19,6 +19,10 @@ import torch
 import torch.distributed
 import torch.nn.functional as F
 import xformers.profiler
+# B200/Blackwell (sm_100): xformers 0.0.30 ships flash-attn3 only with sm_90 kernels,
+# so disable FA3 and let xformers fall back to flash2/cutlass which work on sm_100.
+from xformers.ops.fmha.dispatch import _set_use_fa3 as _xfmr_set_use_fa3
+_xfmr_set_use_fa3(False)
 from torch.optim import lr_scheduler
 from torch.distributed.checkpoint.stateful import Stateful
 from torch.distributed._tensor import DTensor
@@ -449,13 +453,27 @@ def train(args: TrainArgs):
             # optimizer step
             grad_norm = -1.0
             if train_state.acc_step == 0:
-                grad_norm = torch.nn.utils.clip_grad_norm_(
-                    model.parameters(), max_norm=args.optim.clip, foreach=True
+                # Fully manual DTensor-safe clip: torch 2.7.0 + FSDP2's DTensor
+                # `full_tensor()`/`redistribute` call into functional all_reduce that
+                # fails `get_group_info` lookup in this env (cu128 build).
+                # Bypass by extracting local tensors and doing one explicit all_reduce.
+                _grads = [p.grad for p in model.parameters() if p.grad is not None]
+                _local_sumsq = torch.zeros((), device=_grads[0].device, dtype=torch.float32)
+                for _g in _grads:
+                    _gl = _g.to_local() if isinstance(_g, DTensor) else _g
+                    _local_sumsq += _gl.detach().float().pow(2).sum()
+                if torch.distributed.is_initialized():
+                    torch.distributed.all_reduce(
+                        _local_sumsq, op=torch.distributed.ReduceOp.SUM
+                    )
+                total_norm = _local_sumsq.sqrt()
+                clip_coef = torch.clamp(
+                    args.optim.clip / (total_norm + 1e-6), max=1.0
                 )
-
-                grad_norm = (
-                    grad_norm.full_tensor() if isinstance(grad_norm, DTensor) else grad_norm
-                ).item()
+                for _g in _grads:
+                    _gl = _g.to_local() if isinstance(_g, DTensor) else _g
+                    _gl.mul_(clip_coef.to(_gl.dtype))
+                grad_norm = total_norm.item()
 
                 optimizer.step()
                 scheduler.step()
