From 25b73ca73ac97616aa17a32909429f7ed9656d2b Mon Sep 17 00:00:00 2001
From: hyunW3 <0176778602@naver.com>
Date: Sat, 23 May 2026 14:27:47 +0900
Subject: [PATCH 04/22] data: add 'dclm_baseline_1.0_2shards' download option
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds a smaller DCLM subset (2 local shards = 2% of full corpus) sized
to fit the AU-Net 2 1.3B Table 2 row 1 training budget (60B LLaMA
tokens ≈ 273B bytes) without exceeding the workspace's 2.8 TB free
space:
  - global-shard_01_of_10/local-shard_{0,1}_of_10/*.jsonl.zst
  - ~134 GB compressed → ~397 GB shuffled jsonl on disk

Same shuffle / split / validation pipeline as the existing presets.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 setup/download_prepare_hf_data.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/setup/download_prepare_hf_data.py b/setup/download_prepare_hf_data.py
index a5d6e1c..38afa27 100644
--- a/setup/download_prepare_hf_data.py
+++ b/setup/download_prepare_hf_data.py
@@ -83,6 +83,7 @@ def main(dataset, memory, data_dir, seed=42, nchunks=32):
         "fineweb_edu_10bt": "HuggingFaceFW/fineweb-edu",
         "dclm_baseline_1.0": "mlfoundations/dclm-baseline-1.0",
         "dclm_baseline_1.0_10prct": "mlfoundations/dclm-baseline-1.0",
+        "dclm_baseline_1.0_2shards": "mlfoundations/dclm-baseline-1.0",
     }[dataset]
     src_dir = f"{data_dir}/{dataset}"
     out_dir = f"{src_dir}_shuffled"
@@ -94,18 +95,24 @@ def main(dataset, memory, data_dir, seed=42, nchunks=32):
         "fineweb_edu_10bt": ".jsonl",
         "dclm_baseline_1.0": ".jsonl.zst",
         "dclm_baseline_1.0_10prct": ".jsonl.zst",
+        "dclm_baseline_1.0_2shards": ".jsonl.zst",
     }[dataset]
     cat_command = {
         "fineweb_edu": "cat {}",
         "fineweb_edu_10bt": "cat {}",
         "dclm_baseline_1.0": "zstdcat {} && echo",
         "dclm_baseline_1.0_10prct": "zstdcat {} && echo",
+        "dclm_baseline_1.0_2shards": "zstdcat {} && echo",
     }[dataset]
     allow_patterns = {
         "fineweb_edu": None,
         "fineweb_edu_10bt": "sample/10BT/*",
         "dclm_baseline_1.0": "*.jsonl.zst",
         "dclm_baseline_1.0_10prct": "global-shard_01_of_10/*.jsonl.zst",
+        "dclm_baseline_1.0_2shards": [
+            "global-shard_01_of_10/local-shard_0_of_10/*.jsonl.zst",
+            "global-shard_01_of_10/local-shard_1_of_10/*.jsonl.zst",
+        ],
     }[dataset]
     suffix = ".jsonl"
     k_validation = 10000  # Number of lines to take from each chunk for validation
-- 
