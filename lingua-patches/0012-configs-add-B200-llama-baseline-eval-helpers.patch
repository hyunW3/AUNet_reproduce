From: hyunW3 <0176778602@naver.com>
Date: Mon, 1 Jun 2026 23:22:23 +0900
Subject: [PATCH 12/22] configs: add B200 llama baseline eval helpers

---
 apps/main/configs/llama_1B_b200.yaml | 103 +++++++++++++++++++++++++++
 run_eval.sh                          |   7 ++
 2 files changed, 110 insertions(+)
 create mode 100644 apps/main/configs/llama_1B_b200.yaml
 create mode 100644 run_eval.sh

diff --git a/apps/main/configs/llama_1B_b200.yaml b/apps/main/configs/llama_1B_b200.yaml
new file mode 100644
index 0000000..587d656
--- /dev/null
+++ b/apps/main/configs/llama_1B_b200.yaml
@@ -0,0 +1,103 @@
+# Transformer BPE 1.8B baseline (Table 2, "Transf. BPE" row at DM=10) — 4× B200 single-node.
+# Reproduces arXiv 2506.14761 Table 2 row "Dim=2048 (1B model), 60B tokens, DM=10 / Transf. BPE 1.8B"
+# (HellaSwag 63.6 ± 1.0, ARC-E 62.8 ± 1.9 — to compare against AU-Net 2 1.3B HellaSwag 64.2 / ARC-E 64.4).
+#
+# Schedule derived from Table 6 (Appendix D) with compute budget C = 7e20 FLOPs:
+#   - LR = 19.3 · C^-0.177 = 3.94e-3 (rounded to 3.9e-3)
+#   - BSZ = 29.9 · C^0.231 = 1.95M BPE tokens / step (global)
+#         → 24 (bs) × 10 (grad_acc) × 4 (gpus) × 2048 (seq) = 1.966M tokens/step  (+0.8% vs paper)
+#   - total tokens = 60B BPE → steps = 60e9 / 1.966M = 30,520 → rounded to 30,800
+#   - warmup = 10% of total steps = 3,080
+#   - weight_decay 0.1, lr_min_ratio 0.01, grad_clip 0.2, seq_len 2048, cosine schedule
+# Architecture (Table 9 "Transformer 1B BPE"): dim 2048 / n_layers 25 / head_dim 128 / FFN 5632.
+#   Lingua's default FFN = int(4·dim·2/3) aligned to multiple_of=256 → 5632 ✓
+#   With tiktoken cl_toplang_128k (vocab 128k) untied I/O embed = 128k × 2048 × 2 ≈ 525M params ✓
+#
+# B200 fixes inherited from aunet2_1.3B_b200.yaml:
+#   - compile: false  (torch 2.7.0 + FSDP2 DTensor full_tensor() raises get_group_info)
+#   - SAC: false      (kept conservative; this model doesn't need AU-Net's inplace-tensor workaround)
+#   - FA3 disable + ENABLE_INTRA_NODE_COMM=0 patches live in apps/main/train.py + lingua/distributed.py
+#     (mirror the equivalents from apps/aunet/train.py if not already applied)
+#
+# Launch:
+#   torchrun --nproc-per-node 4 --master-port 29502 -m apps.main.train \
+#       config=apps/main/configs/llama_1B_b200.yaml
+#
+# Prereq:
+#   - Download tokenizer:
+#       python setup/download_tokenizer.py llama3 tokenizers --api_key $HF_TOKEN
+#     OR fetch cl_toplang_128k.tiktoken directly (paper uses 128k-vocab BPE).
+#     File must end up at lingua/tokenizers/cl_toplang_128k.tiktoken
+#
+dump_dir: /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/runs/llama_1B_dm10
+name: "llama_1B_dm10_b200"
+steps: 30800
+grad_acc_steps: 15
+probe_freq: null
+
+seed: 777
+optim:
+  lr: 3.9e-3
+  warmup: 3080
+  weight_decay: 0.1
+  lr_min_ratio: 0.01
+  clip: 0.2
+
+distributed:
+  fsdp_type: full_shard
+  compile: false
+  model_dtype: bf16
+  matmul_allow_tf32: false
+  selective_activation_checkpointing: false
+  tp_size: 1
+
+model:
+  dim: 2048
+  n_layers: 25
+  n_heads: 16
+
+data:
+  root_dir: /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/data
+  sources:
+    dclm_baseline_1.0_2shards_shuffled: 1.0
+  batch_size: 16 #24
+  prefetch_size: 1024
+  seq_len: 2048
+  n_views: 2
+  load_async: true
+  add_bos: true
+  add_eos: true
+  tokenizer:
+    name: tiktoken
+    path: /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/tokenizer/llama3/tokenizer.model
+
+profiling:
+  run: true
+  mem_warmup: 0
+  mem_steps: 4
+  profile_warmup: 100
+  profile_steps: 4
+
+checkpoint:
+  dump:
+    every: 2000
+    keep: 1
+  eval:
+    # Disable mid-training eval (no spare GPUs for async eval); final eval after run completes.
+    every: 9999999
+    keep: 1
+
+logging:
+  freq: 1
+
+async_eval_gpus: 0
+eval:
+  harness:
+    tasks:
+      - hellaswag
+      - arc_easy
+  validation:
+    max_steps: 1000
+  generator:
+    max_tokens: 16384
+    dtype: bf16
diff --git a/run_eval.sh b/run_eval.sh
new file mode 100644
index 0000000..b7bd78e
--- /dev/null
+++ b/run_eval.sh
@@ -0,0 +1,7 @@
+#!/bin/bash
+cd /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/lingua
+source .venv/bin/activate
+LATEST=$(ls -1 /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/runs/aunet2_1.3B/checkpoints/ | sort -n | tail -1)
+python -m apps.aunet.eval \
+    config=apps/aunet/configs/aunet2_1.3B_b200.yaml \
+    ckpt_dir=/NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/runs/aunet2_1.3B/checkpoints/$LATEST
