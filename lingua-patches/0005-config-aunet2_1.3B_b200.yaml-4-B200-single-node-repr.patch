Derived from 2B_1level.yaml (AU-Net 2: dim [512, 2048], layers [3, 25])
with adjustments for one 4-GPU B200 box reproducing Table 2 row 1
of arXiv:2506.14761 (HellaSwag 64.2 / ARC-E 64.4):

- batch_size 12 + grad_acc_steps 4 → global batch 192 (paper used
  16 H100s × 12; we use 4 B200s × 12 × 4)
- async_eval_gpus: 8 → 0 (no spare GPUs on a single-node host)
- compile: false + SAC: false (both interact badly with the rest of
  the env at the moment; see crash log archive in status.md)
- dump_dir, data.root_dir filled in for this workspace

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 apps/aunet/configs/aunet2_1.3B_b200.yaml | 94 ++++++++++++++++++++++++
 1 file changed, 94 insertions(+)
 create mode 100644 apps/aunet/configs/aunet2_1.3B_b200.yaml

diff --git a/apps/aunet/configs/aunet2_1.3B_b200.yaml b/apps/aunet/configs/aunet2_1.3B_b200.yaml
new file mode 100644
index 0000000..b3e37f9
--- /dev/null
+++ b/apps/aunet/configs/aunet2_1.3B_b200.yaml
@@ -0,0 +1,94 @@
+# AU-Net 2 1.3B reproduction on 4× B200 (single node).
+# Reproduces Table 2 row 1 of arXiv 2506.14761 (HellaSwag 64.2 / ARC-E 64.4).
+# Derived from configs/2B_1level.yaml with:
+#   - dump_dir set to local runs dir
+#   - data.root_dir pointing to our DCLM subset (shuffled output)
+#   - batch_size 12 (unchanged) + grad_acc_steps 4 to preserve global batch=192 with 4 GPUs
+#     (paper's setting: 16 H100s × 12 = 192; ours: 4 B200s × 12 × 4 = 192)
+#   - selective_activation_checkpointing=True (B200 OOMs at higher batches without compile,
+#     and SAC gives margin even with compile)
+#   - async_eval_gpus 8 -> 0 (no spare GPUs on single-node 4-GPU host)
+#   - clip_grad_norm patched in train.py to avoid torch 2.7.0 FSDP2+DTensor `get_group_info` bug
+# Launch: torchrun --nproc-per-node 4 -m apps.aunet.train config=apps/aunet/configs/aunet2_1.3B_b200.yaml
+dump_dir: /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/runs/aunet2_1.3B
+name: "aunet2_1.3B_b200"
+steps: 180000
+grad_acc_steps: 4
+probe_freq: null
+
+seed: 777
+optim:
+    lr: 1.65e-3
+    warmup: 10000
+    weight_decay: 0.1
+    lr_min_ratio: 0.01
+    clip: 0.2
+
+distributed:
+    fsdp_type: full_shard
+    compile: false  # torch 2.7.0+cu128 + FSDP2: any DTensor collective (clip_grad's full_tensor) raises `get_group_info: no group info` when compile=true
+    model_dtype: bf16
+    matmul_allow_tf32: false
+    selective_activation_checkpointing: false  # AU-Net mutates long tensors inplace; SAC re-runs them and fails autograd version check
+    tp_size: 1
+    compile_cache_size_limit: 16
+
+model:
+    dimensions: [512, 2048]
+    layers: [3, 25]
+    head_dims: [64, 128]
+    residuals: [True]
+    sliding_windows: [512, 4096]
+    max_seqlens: [-1, 3200]
+    block:
+        rope_theta: 500000.0
+        multiple_of: 256
+    lambda_level: 0.0
+    pooling_type: simple_indexed_matmul
+
+data:
+    root_dir: /NHNHOME/WORKSPACE/0226010285_F/MINDlab/hyunw3/AUNet/data
+    sources:
+      dclm_baseline_1.0_2shards_shuffled: 1.0
+    batch_size: 12
+    prefetch_size: 1024
+    seq_len: 8192
+    n_views: 2
+    load_async: true
+    add_bos: true
+    add_eos: true
+    tokenizer:
+        name: bytes
+
+    regex:
+        strategy:
+            word1: 1@1
+
+profiling:
+  run: true
+  mem_warmup: 0
+  mem_steps: 4
+  profile_warmup: 100
+  profile_steps: 4
+checkpoint:
+    dump:
+        every: 2000
+        keep: 1
+    eval:
+        every: 50000
+        keep: 1
+
+logging:
+  freq: 1
+
+async_eval_gpus: 0
+eval:
+  harness:
+    tasks:
+      - hellaswag
+      - arc_easy
+  validation:
+    max_steps: 1000
+  generator:
+    max_tokens: 16384
+    dtype: bf16
